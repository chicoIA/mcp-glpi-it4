# ── GLPI connection / Conexão GLPI ───────────────────────────────────────────
# Required / Obrigatório: base URL of your GLPI instance.
GLPI_BASE_URL=https://glpi.example.com
GLPI_API_VERSION=v2.3

# ── OAuth2 credentials / Credenciais OAuth2 (Setup > OAuth Clients) ──────────
GLPI_CLIENT_ID=YOUR_CLIENT_ID
GLPI_CLIENT_SECRET=YOUR_CLIENT_SECRET
GLPI_USERNAME=service_account
GLPI_PASSWORD=YOUR_PASSWORD
GLPI_OAUTH_SCOPE=api

# ── Write safety / Segurança de escrita ──────────────────────────────────────
# dry_run (default): simulates POST/PATCH/DELETE and returns the payload only.
# live: performs the write (every write stays recorded for rollback).
GLPI_WRITE_MODE=dry_run

# ── Transport / Transporte ───────────────────────────────────────────────────
# stdio (default) for local clients; streamable-http for a long-running
# container shared by several apps. Host/port are read by FastMCP itself.
MCP_TRANSPORT=stdio
# FASTMCP_HOST=0.0.0.0
# FASTMCP_PORT=8000

# ── Tuning (optional / opcional) ─────────────────────────────────────────────
GLPI_TIMEOUT=15
GLPI_MAX_RETRIES=3
# Folder holding rollback_log.json and error_log.json.
# Pasta onde ficam rollback_log.json e error_log.json.
# Default: ~/.mcp-glpi-it4  ·  in Docker: /data (mount a volume!).
# GLPI_AUDIT_DIR=/data
